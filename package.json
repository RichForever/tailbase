{
  "name": "tailbase-theme",
  "version": "1.6.6",
  "private": true,
  "description": "Tailbase Theme package.json file",
  "keywords": [
    "wordpress",
    "theme",
    "tailwind"
  ],
  "license": "UNLICENSED",
  "author": "MM",
  "scripts": {
    "prebuild": "npm run tokens",
    "build": "webpack --mode=production",
    "prebuild:dev": "npm run tokens",
    "build:dev": "webpack --mode=development",
    "commit": "cz",
    "predev": "npm run tokens",
    "dev": "webpack",
    "preinstall": "npx only-allow npm",
    "prepare": "husky",
    "prettier:check": "npx prettier . --check",
    "prettier:write": "npx prettier . --write",
    "release": "release-it",
    "tailwind:sort": "tailwind-sort-php",
    "tokens": "node scripts/build-tokens.js",
    "prewatch": "npm run tokens",
    "watch": "webpack --watch",
    "zip": "npm run build && node scripts/zip-theme.js"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --quiet --fix",
    "*.{json,js,ts,jsx,tsx,html,css}": "prettier --write --ignore-unknown",
    "*.php": "tailwind-sort-php"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@release-it/bumper": "^8.0.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@runtimestudio/tailwind-sort-php": "^0.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "alpinejs": "^3.17.4",
    "archiver": "^8.0.0",
    "commitizen": "^4.3.2",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "image-minimizer-webpack-plugin": "^5.0.0",
    "imagemin": "^9.0.1",
    "imagemin-gifsicle": "^7.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-svgo": "^12.0.0",
    "lint-staged": "^17.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.4.21",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "release-it": "^21.1.1",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "webpack": "^5.112.0",
    "webpack-assets-manifest": "^6.5.4",
    "webpack-cli": "^7.2.3",
    "webpack-remove-empty-scripts": "^1.0.1"
  },
  "allowScripts": {
    "mozjpeg@8.0.0": true,
    "gifsicle@5.3.0": true,
    "pngquant-bin@9.0.0": true,
    "esbuild@0.28.2": true
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}"
    },
    "github": {
      "release": false
    },
    "npm": {
      "publish": false
    },
    "plugins": {
      "@release-it/bumper": {
        "in": "style.css",
        "out": "style.css",
        "regex": "Version:\\s*([\\d.]+)"
      },
      "@release-it/conventional-changelog": {
        "infile": "CHANGELOG.md",
        "preset": {
          "name": "conventionalcommits",
          "types": [
            {
              "type": "feat",
              "section": "🚀 Features",
              "hidden": false
            },
            {
              "type": "fix",
              "section": "🐛 Bug Fixes",
              "hidden": false
            },
            {
              "type": "docs",
              "section": "📝 Documentation",
              "hidden": false
            },
            {
              "type": "style",
              "section": "💄 Code Style",
              "hidden": false
            },
            {
              "type": "refactor",
              "section": "♻️ Refactoring",
              "hidden": false
            },
            {
              "type": "perf",
              "section": "⚡ Performance Improvements",
              "hidden": false
            },
            {
              "type": "test",
              "section": "🧪 Tests",
              "hidden": false
            },
            {
              "type": "build",
              "section": "🏗 Build System",
              "hidden": false
            },
            {
              "type": "ci",
              "section": "🔧 Continuous Integration",
              "hidden": false
            },
            {
              "type": "chore",
              "section": "📦 Miscellaneous",
              "hidden": false
            },
            {
              "type": "revert",
              "section": "⏪ Reversions",
              "hidden": false
            }
          ]
        }
      }
    }
  }
}
